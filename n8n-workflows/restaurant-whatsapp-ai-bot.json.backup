        "recipientPhoneNumber": "={{ $('Edit Fields3').first().json.fromNumber }}",
        "textBody": "=Dear {{ JSON.parse($('HTTP Request2').first().json.data).data.customerName }},\n\nWe have received your booking request. Please pay the 20% advance below so our team can verify it and confirm your reservation.\n\n*Booking reference*: {{ JSON.parse($('HTTP Request2').first().json.data).data._id }}\n*Package*: {{ JSON.parse($('HTTP Request2').first().json.data).data.package }}\n*Date*: {{ new Date(JSON.parse($('HTTP Request2').first().json.data).data.bookingDate).toLocaleDateString('en-PK', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'Asia/Karachi' }) }}\n{{ JSON.parse($('HTTP Request2').first().json.data).data.roomType ? '*Room type*: ' + JSON.parse($('HTTP Request2').first().json.data).data.roomType + '\\n*Rooms*: ' + JSON.parse($('HTTP Request2').first().json.data).data.numberOfRooms + '\\n*Check-out*: ' + new Date(JSON.parse($('HTTP Request2').first().json.data).data.checkOutDate).toLocaleDateString('en-PK', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'Asia/Karachi' }) : '*Time*: ' + JSON.parse($('HTTP Request2').first().json.data).data.bookingTime }}\n*Guests*: {{ JSON.parse($('HTTP Request2').first().json.data).data.numberOfPersons }}\n*Total*: Rs {{ Number(JSON.parse($('HTTP Request2').first().json.data).data.totalAmount).toLocaleString('en-PK') }}\n*20% advance*: Rs {{ Number(JSON.parse($('HTTP Request2').first().json.data).data.advanceAmount).toLocaleString('en-PK') }}\n\n*Bank*: {{ JSON.parse($('HTTP Request2').first().json.data).paymentInstructions.bankName }}\n*Account title*: {{ JSON.parse($('HTTP Request2').first().json.data).paymentInstructions.accountTitle }}\n*Account number*: {{ JSON.parse($('HTTP Request2').first().json.data).paymentInstructions.accountNumber }}\n*IBAN*: {{ JSON.parse($('HTTP Request2').first().json.data).paymentInstructions.iban }}\n\nAfter paying, please send your payment screenshot here on WhatsApp. Your booking will be confirmed only after our team verifies the advance.\n\nThank you, Hotel d'GATES.",
