    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.output;\n\n// Strip markdown code block wrapper (```json ... ```)\nconst cleaned = raw.replace(/```json\\n?/g, '').replace(/```/g, '').trim();\n\nconst booking = JSON.parse(cleaned);\n\nreturn [{ json: booking }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -656,
        720
      ],
      "id": "58ae51eb-3392-4ce1-a019-2c2b36e22cd8",
      "name": "Booking Code"
    },
    {
      "parameters": {
        "jsCode": "const booking = $input.first().json;\nconst order = booking.order || {};\nconst packageName = String(order.package || '').trim();\nlet category = String(order.category || '').trim();\nif (!category || category === 'Wedding Package') {\nif (/hi[\\s-]?tea|hitea/i.test(packageName)) category = 'Hi-Tea Buffet';\nelse if (/dinner|buffet/i.test(packageName)) category = 'Dinner Buffet';\nelse if (/pool|gym|swim/i.test(packageName)) category = 'Pool/Gym';\nelse if (/wedding|shaadi|shadi|nikah|walima|mehndi/i.test(packageName)) category = 'Wedding';\nelse if (/room|accommodation|suite/i.test(packageName)) category = 'Rooms';\nelse if (/movie\\s*night|auditorium/i.test(packageName)) category = 'Auditorium / Movie Night + Hi-Tea';\nelse if (/a\\s*la\\s*carte|alacarte|restaurant|table/i.test(packageName)) category = '\\u00c0 la carte / Restaurant Reservation';\nelse if (/corporate|conference|meeting/i.test(packageName)) throw new Error('Corporate bookings must be handled through the corporate event request flow.');\nelse throw new Error('Choose a configured booking category from the live CRM menu.');\n}\nif (category === 'Wedding Package') category = 'Wedding';\nif (category === 'A la carte / Restaurant Reservation') category = '\\u00c0 la carte / Restaurant Reservation';\nif (category === 'Corporate') throw new Error('Corporate bookings must be handled through the corporate event request flow.');\nconst date = String(order.date || '').slice(0, 10);\nconst parsedDate = new Date(date + 'T00:00:00.000Z');\nif (!/^\\d{4}-\\d{2}-\\d{2}$/.test(date) || Number.isNaN(parsedDate.getTime()) || parsedDate.toISOString().slice(0, 10) !== date) throw new Error('Check-in date must be a valid YYYY-MM-DD date.');\nconst persons = Number(order.persons);\nif (!Number.isInteger(persons) || persons < 1) throw new Error('Guest count must be a positive whole number.');\nif (category === 'Rooms') {\n  const checkOutDate = String(order.checkOutDate || '').slice(0, 10);\n  const parsedCheckOut = new Date(checkOutDate + 'T00:00:00.000Z');\n  if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(checkOutDate) || Number.isNaN(parsedCheckOut.getTime()) || parsedCheckOut.toISOString().slice(0, 10) !== checkOutDate || checkOutDate <= date) throw new Error('Room check-out must be a valid date after check-in.');\n  if (!/^[a-f0-9]{24}$/i.test(String(order.roomTypeId || ''))) throw new Error('Choose a configured room type from the live CRM room list.');\n  const rooms = Number(order.numberOfRooms || 1);\n  if (!Number.isInteger(rooms) || rooms < 1 || rooms > 100) throw new Error('Room count must be a whole number from 1 to 100.');\n  const query = new URLSearchParams({ restaurantId: 'restaurant-1', checkInDate: date, checkOutDate, roomTypeId: String(order.roomTypeId), rooms: String(rooms), guests: String(persons) });\n  return [{ json: { ...booking, availabilityUrl: 'https://magenta-yak-337378.hostingersite.com/api/rooms/availability/check?' + query } }];\n}\nconst timeMatch = String(order.time || '').trim().match(/^(\\d{1,2})(?::(\\d{2}))?\\s*(AM|PM)?$/i);\nif (!timeMatch) throw new Error('Booking time must be a valid time such as 7:00 PM.');\nlet hour = Number(timeMatch[1]);\nconst minute = Number(timeMatch[2] || 0);\nif (minute > 59 || hour > 23 || (timeMatch[3] && (hour < 1 || hour > 12))) throw new Error('Booking time is invalid.');\nif (timeMatch[3]) hour = hour % 12 + (timeMatch[3].toUpperCase() === 'PM' ? 12 : 0);\nconst time = ('0' + hour).slice(-2) + ':' + ('0' + minute).slice(-2);\nconst query = new URLSearchParams({ restaurantId: 'restaurant-1', date, time, persons: String(persons), category });\nreturn [{ json: { ...booking, availabilityUrl: 'https://magenta-yak-337378.hostingersite.com/api/slots/availability?' + query } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
