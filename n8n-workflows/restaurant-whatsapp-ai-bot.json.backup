    },
    {
      "parameters": {
        "jsCode": "const raw = String($input.first().json.output || '').replace(/\\x60\\x60\\x60(?:json)?/gi, '').trim();\nconst result = JSON.parse(raw);\nif (result.action !== 'create_reminder' || !result.reminder || !result.reminder.reason) throw new Error('AI follow-up reminder output is incomplete.');\nconst event = $('Edit Fields').first().json;\nconst message = event.messages?.[0] || {};\nconst receivedAt = new Date(Number(message.timestamp) * 1000);\nif (!message.id || Number.isNaN(receivedAt.getTime())) throw new Error('WhatsApp message ID or timestamp is missing.');\nreturn [{ json: { restaurantId: 'restaurant-1', fromNumber: $('Edit Fields3').first().json.fromNumber, customerName: String(result.customer?.name || event.contacts?.[0]?.profile?.name || '').trim(), reason: result.reminder.reason, customerMessage: String(result.reminder.customerMessage || $('Edit Fields3').first().json.userMessage || '').trim(), receivedAt: receivedAt.toISOString(), sourceMessageId: message.id, reply: String(result.reply || '').trim() } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
