    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const source = $input.first().json;\nconst response = $('Get current CRM menus').first().json;\nconst menus = Array.isArray(response.data) ? response.data : [];\nconst menu = menus.find((item) => item.category === source.category && item.isActive !== false);\nif (!menu) return [];\nconst media = menu.media || {};\nconst assets = [\n  ...(media.imageUrls || []).map((url) => ({ type: 'image', url, caption: menu.captionAfterImage || '' })),\n  ...(media.pdfUrls || []).map((url) => ({ type: 'document', url, filename: url.split('/').pop().split('?')[0] || 'menu.pdf' })),\n  ...(media.videoUrl ? [{ type: 'video', url: media.videoUrl }] : []),\n  ...(media.voiceNoteUrl ? [{ type: 'audio', url: media.voiceNoteUrl }] : []),\n];\nreturn assets\n  .filter((asset) => typeof asset.url === 'string' && /^https:\\/\\//i.test(asset.url))\n  .map((asset) => ({ json: { ...asset, to: source.fromNumber } }));"
      },
