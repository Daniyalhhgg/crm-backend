    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const menuResponse = $('Get current CRM menus').first().json;\nconst roomTypeResponse = $('Get current CRM room types').first().json;\nconst roomTypes = Array.isArray(roomTypeResponse.data) ? roomTypeResponse.data.filter((room) => room.isActive !== false).map(({ _id, name, baseRate, totalRooms, maxGuestsPerRoom, description, amenities }) => ({ roomTypeId: _id, name, nightlyRate: baseRate, totalRooms, maxGuestsPerRoom, description, amenities })) : [];\nconst menus = Array.isArray(menuResponse.data) ? menuResponse.data : [];\nconst conciseMenus = menus.filter((menu) => menu.isActive !== false).map((menu) => ({\n  category: menu.category, title: menu.title, subtitle: menu.subtitle, badge: menu.badge, closingLine: menu.closingLine,\n  price: menu.price, priceNote: menu.priceNote, menuTimeSlots: menu.menuTimeSlots || [], menuSections: menu.menuSections || [], roomCheckInTime: menu.roomCheckInTime || \"\", roomCheckOutTime: menu.roomCheckOutTime || \"\", roomStayDurationHours: menu.roomStayDurationHours || null, hotelInfo: menu.hotelInfo || {},\n  description: menu.description, dishes: menu.dishes || [], weddingPackages: menu.weddingPackages || [],\n  weddingVenues: menu.weddingVenues || [], weddingSaladOptions: menu.weddingSaladOptions || [], weddingDessertOptions: menu.weddingDessertOptions || [], extraPrices: menu.extraPrices || [],\n  media: { imageUrls: menu.media?.imageUrls || [], pdfUrls: menu.media?.pdfUrls || [], videoUrl: menu.media?.videoUrl || \"\", voiceNoteUrl: menu.media?.voiceNoteUrl || \"\" },\n  activeOffers: (menu.activeOffers || []).map(({ title, description, discountText }) => ({ title, description, discountText })),\n}));\nconst closureResponse = $input.first().json;\nconst closureData = closureResponse.data || {};\nconst closures = Array.isArray(closureData.closures) ? closureData.closures : [];\nconst closureContext = JSON.stringify({\n  currentDateInPakistan: closureData.today || 'Unknown',\n  priorityInstruction: 'Check these closures before greeting or replying about availability/booking. If today is closed, tell the customer the exact reason immediately. Never promise or create a booking on a listed closed date.',\n  closures: closures.map(({ date, reason }) => ({ date, reason })),\n});\nconst source = $('Edit Fields3').first().json;\nreturn [{ json: { ...source, menuContext: JSON.stringify(conciseMenus), roomTypesContext: JSON.stringify(roomTypes), closureContext } }];"
      },
